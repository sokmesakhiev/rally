# Turns package.json's `engines.node` from advice into an error.
#
# `scripts/build-sitemap.mjs` imports a .ts module, which Node executes
# directly only from 22.18 (type stripping on by default; 22.6–22.17 needed
# --experimental-strip-types). Below that it dies with ERR_UNKNOWN_FILE_EXTENSION,
# which says nothing about the actual cause. Without engine-strict npm only
# warns, so the first sign of trouble is a cryptic build failure rather than a
# sentence naming the version you need.
#
# CI and the deploy workflow both run Node 24 (see .github/workflows/), so this
# only ever bites a local checkout — which is exactly where a legible message
# is worth most.
engine-strict=true
