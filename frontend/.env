# Copy to .env.local
VITE_API_URL=http://localhost:3001

# Optional. Enables the interactive location picker (search-as-you-type +
# draggable pin) on the create-event form. Needs a Google Cloud project with
# the "Maps JavaScript API" and "Places API" enabled, and the key restricted
# to your domain(s). Without it, the location field falls back to a plain
# text input — event creation still works, it just won't capture
# coordinates or show a "View on map" link.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Enables the "Continue with Google" button on the sign-in page.
# From the same (or a separate) Google Cloud project as above — an OAuth 2.0
# Client ID (Web application type), with this app's URL added as an
# authorized JavaScript origin. Without it, the button is hidden and
# email/password remains the only sign-in method. Must match the backend's
# GOOGLE_CLIENT_ID (see infrastructure/variables.tf's google_client_id).
VITE_GOOGLE_CLIENT_ID=

# Optional. Enables invisible reCAPTCHA v3 protection on account creation
# (the sign-up form). From a Google account at
# https://www.google.com/recaptcha/admin — register a "reCAPTCHA v3" site
# with this app's domain(s). Without it, signup works with no captcha check
# at all. Must be paired with the backend's RECAPTCHA_SECRET_KEY (see
# infrastructure/variables.tf's recaptcha_secret_key) — setting only one side
# has no effect (the frontend key alone can't verify anything without the
# backend secret, and the backend only enforces verification once its secret
# is set).
VITE_RECAPTCHA_SITE_KEY=6LdHbXYtAAAAAI3jH8hgaE0M345Yn4MepfOAzQE1

# Optional. Enables frontend error tracking via Sentry. A DSN is a write-only
# ingest endpoint, not a secret — it's compiled into the JS bundle by design.
# Without it, Sentry is never initialized and all reporting calls no-op, so
# local development needs no Sentry account. Pair with the backend's
# SENTRY_DSN (infrastructure/variables.tf's sentry_dsn) to see both sides of
# an incident in one place.
VITE_SENTRY_DSN=

# Optional. Labels events in Sentry (defaults to Vite's MODE) and ties them to
# a deploy. Set VITE_GIT_SHA in CI to the commit being built so frontend and
# backend releases correlate — the backend reads the same value as GIT_SHA.
VITE_SENTRY_ENVIRONMENT=
VITE_GIT_SHA=
