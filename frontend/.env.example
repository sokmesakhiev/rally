# Copy to .env.local
VITE_API_URL=http://localhost:3001

# Optional. Enables the interactive location picker (search-as-you-type +
# draggable pin) on the create-event form. Needs a Google Cloud project with
# the "Maps JavaScript API" and "Places API" enabled, and the key restricted
# to your domain(s). Without it, the location field falls back to a plain
# text input — event creation still works, it just won't capture
# coordinates or show a "View on map" link.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Enables the "Continue with Google" button on the sign-in page.
# From the same (or a separate) Google Cloud project as above — an OAuth 2.0
# Client ID (Web application type), with this app's URL added as an
# authorized JavaScript origin. Without it, the button is hidden and
# email/password remains the only sign-in method. Must match the backend's
# GOOGLE_CLIENT_ID (see infrastructure/variables.tf's google_client_id).
VITE_GOOGLE_CLIENT_ID=
