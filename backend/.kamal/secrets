# Secrets referenced by config/deploy.yml and config/deploy.staging.yml.
#
# **Everything here comes from the environment, nothing from a file.** The
# scaffolding this replaced read `RAILS_MASTER_KEY=$(cat config/master.key)`,
# which cannot work in CI — `config/master.key` is gitignored, so the runner
# has no such file and the deploy fails at `kamal deploy` with a missing
# secret rather than anywhere informative.
#
# This file is safe to commit: it contains no values, only the names it reads
# out of the environment. That is the whole convention — see Kamal's docs on
# secrets.
#
# Where the values come from:
#   * CI — GitHub Actions secrets, passed into the `kamal deploy` step's `env:`
#     block. See .github/workflows/deploy-staging.yml.
#   * A laptop — export them, or source a gitignored file. Do not add raw
#     credentials to this file to make a local deploy easier; `kamal deploy`
#     from a laptop is a debugging tool, not the deploy path.
#
# `kamal` fails loudly if a name listed under `env.secret` in deploy*.yml is
# missing here, so this list and that one are checked against each other on
# every deploy — no drift to discover later.

# ── Registry ───────────────────────────────────────────────────────────────
# An ECR authorization token, not a password. It expires after 12 hours, so the
# workflow mints one per run with `aws ecr get-login-password`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# ── Rails ──────────────────────────────────────────────────────────────────
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Signs every JWT. A different value from production's, deliberately: a token
# minted on staging must not authenticate against production, and the tokens
# last 30 days.
JWT_SECRET=$JWT_SECRET

# ── Database ───────────────────────────────────────────────────────────────
# Assembled rather than passed in, so there is one source of truth for the
# password — the accessory container and the app have to agree, and two
# separate secrets that must match is a bug waiting for a rotation.
#
# `rally-db` is the accessory's hostname on Kamal's Docker network
# (<service>-<accessory>), which is why no port is published to the box.
#
# config/database.yml derives the cache, queue and cable URLs from this one by
# swapping the database name, so only `primary` is named here.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgresql://rally:${POSTGRES_PASSWORD}@rally-db:5432/rally_staging

# ── Third parties ──────────────────────────────────────────────────────────
# ABA's **sandbox** credentials. deploy.staging.yml pins
# ABA_PAYWAY_BASE_URL to the sandbox host explicitly; putting live credentials
# here would be the one configuration mistake in this repository that can move
# real money.
ABA_PAYWAY_MERCHANT_ID=$ABA_PAYWAY_MERCHANT_ID
ABA_PAYWAY_API_KEY=$ABA_PAYWAY_API_KEY

# Both of these are optional in the app — RecaptchaVerifier passes everything
# when unset, and Sentry no-ops without a DSN — but Kamal requires every name
# listed under `env.secret` to resolve, so they are defined here and may be
# empty strings in CI.
RECAPTCHA_SECRET_KEY=$RECAPTCHA_SECRET_KEY
SENTRY_DSN=$SENTRY_DSN
