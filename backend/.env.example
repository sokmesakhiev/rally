# Copy to .env (gitignored). Loaded automatically in development/test by the
# dotenv-rails gem (see Gemfile) — never loaded in production, which gets its
# config exclusively from real ENV vars injected by ECS (see
# infrastructure/ecs.tf, infrastructure/secrets.tf).
#
# Nothing here is required to boot the app — every var either has a working
# default for local dev or gates an optional feature off entirely when unset.

# Recommended. Signs JWTs (lib/json_web_token.rb). Without it, falls back to
# Rails' own secret_key_base, which is fine but changes if you ever rotate
# config/master.key — every previously-issued token (and anyone's "stay
# signed in" session) would stop validating. Any random string works locally;
# it doesn't need to match production's.
JWT_SECRET=

# Backend base URL for webhooks and callbacks (e.g., ABA PayWay).
# Defaults to request.base_url if not set.
BACKEND_URL=http://localhost:3000

# Frontend base URL for CORS, email links, and other references.
# Defaults to http://localhost:3000 in config/initializers/cors.rb
FRONTEND_URL=http://localhost:5173

# Optional. Needed to exercise the ABA PayWay (KHQR) payment flow locally —
# see ABA_PAYWAY_SETUP.md for how to get sandbox credentials. Without these,
# event/registration creation still works, just not publishing a paid plan or
# paying for a paid registration. ABA_PAYWAY_BASE_URL is pre-set to ABA's
# sandbox in development (config/payway.yml) — only override it if you need
# to point at a different PayWay environment.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
# ABA_PAYWAY_BASE_URL=

# Optional. Verifies "Sign in with Google" ID tokens server-side
# (AuthController#google). Must match the frontend's VITE_GOOGLE_CLIENT_ID —
# without both sides set, the Google sign-in button stays hidden and
# email/password remains the only sign-in path.
GOOGLE_CLIENT_ID=

# Optional. Enables web push notifications (Notifications::DeliverPush). Both
# halves are required — with either missing, push is cleanly off: the API
# reports enabled: false, the frontend hides the feature, and the null adapter
# logs instead of sending. Generate a pair with:
#
#   bundle exec ruby -rwebpush -e 'puts WebPush.generate_key.to_h'
#
# The public key is genuinely public (every subscribing browser gets it, via
# GET /api/v1/push/vapid_public_key). The private key is a secret.
#
# ROTATING THESE INVALIDATES EVERY EXISTING SUBSCRIPTION — browsers tie a
# subscription to the public key it was created with, so every device silently
# stops receiving notifications and has to re-subscribe. See
# docs/PUSH-NOTIFICATIONS.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address a push service can use if our notifications misbehave.
# Defaults to mailto: MAILER_FROM_EMAIL.
# VAPID_SUBJECT=mailto:admin@rails-dev.com

# Optional. Verifies reCAPTCHA v3 tokens on signup (RecaptchaVerifier). Must
# be paired with the frontend's VITE_RECAPTCHA_SITE_KEY — without both sides
# set, signup works with no captcha check at all.
RECAPTCHA_SECRET_KEY=

# Optional. Pins Active Record encryption keys (used for
# Profile#payway_api_key) to fixed values. Without these, keys are derived
# from secret_key_base instead — fine for a normal dev session, but if you
# ever rotate config/master.key locally, any previously-encrypted
# payway_api_key becomes unreadable. Generate real values with
# `bin/rails db:encryption:init` if you want stability across master-key
# rotations.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Optional. Sends real outgoing mail via SES instead of just logging it — see
# ABA_PAYWAY_SETUP.md's "Local development" section for alternatives
# (Rails.logger, letter_opener, Mailhog) that don't need AWS credentials at
# all.
# MAILER_FROM_EMAIL=

# Optional. Frontend error tracking has its own VITE_SENTRY_DSN — this is the
# backend's counterpart. Unset, Sentry is never initialized and every call
# no-ops.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# AWS region for SES and S3. Defaults to ap-southeast-1.
AWS_REGION=ap-southeast-1

# S3 bucket for file storage. Defaults to "rally".
AWS_BUCKET=rally

# Puma server configuration (config/puma.rb)
PORT=3000
RAILS_MAX_THREADS=5

# Rails log level in production (config/environments/production.rb)
# Options: debug, info, warn, error, fatal, unknown
RAILS_LOG_LEVEL=info

# Job worker concurrency (config/queue.yml)
JOB_CONCURRENCY=1

# From email address
# Unquoted deliberately. dotenv strips surrounding quotes, so they never
# reached ENV locally — but production sets this straight from ECS, where
# quotes WOULD be literal and would end up inside the VAPID `sub` claim
# (Notifications::Vapid#subject) and the mail From header.
MAILER_FROM_EMAIL=noreply@rails-dev.com

# Optional. Selects the Sms::Client adapter used to text phone-only guests a
# registration confirmation (see Sms::Client, Registrations::SendPhoneConfirmation).
# No real provider is wired up yet — unset (or "null") logs the message instead
# of sending it. See Ticket 1 in registration-engagement-tickets.md.
# SMS_PROVIDER=null

# Optional, and deliberately OFF for now. When true, an event can only be
# published if its organization has a name, logo, description, and at least one
# contact method (see Organization.identity_required_for_publishing? and
# organization-identity-tickets.md's Ticket E).
#
# Leave unset until Ticket G (#336) ships the organization settings UI. Every
# organization today was created by a backfill or implicitly on first event
# creation, so none have a description or contact details, and there is no way
# in the app to add them yet — turning this on early blocks all publishing.
# REQUIRE_ORGANIZATION_IDENTITY=true