source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"
gem "bootsnap", require: false
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Auth
gem "bcrypt", "~> 3.1.7"
gem "jwt", "~> 3.2"
gem "googleauth", "~> 1.17" # verifies Google ID tokens for "Sign in with Google" (see AuthController#google)

# CORS
gem "rack-cors"

# Rate limiting / throttling — see config/initializers/rack_attack.rb
gem "rack-attack", "~> 6.7"

# Error tracking / performance monitoring — see config/initializers/sentry.rb.
# Inert unless SENTRY_DSN is set, so local/CI runs send nothing.
gem "sentry-ruby", "~> 5.17"
gem "sentry-rails", "~> 5.17"

# File uploads
gem "image_processing", "~> 2.0"
gem "aws-sdk-s3", require: false # Active Storage S3 backend in production

# Certificates of participation — an .odt is a zip of XML files; rubyzip lets
# Certificates::MergeOdt substitute {{tokens}} in content.xml/styles.xml
# without needing LibreOffice just to read/write the template itself (only
# the final ODT→PDF conversion shells out to `soffice`, in
# Certificates::RenderPdf — see the Dockerfile for that runtime dependency).
gem "rubyzip", "~> 3.4", require: "zip"

# CSV results import (Results::ImportCsv) — "csv" moved from a Ruby default
# gem to a bundled gem as of Ruby 3.4, so under Bundler it needs an explicit
# Gemfile entry rather than just `require "csv"` working implicitly.
gem "csv"

# Transactional email via Amazon SES (production only; see config/environments/production.rb)
gem "aws-sdk-rails", "~> 5"
gem "aws-actionmailer-ses", "~> 1"

# Deploy
gem "kamal", require: false
gem "thruster", require: false

gem "importmap-rails"

gem "solid_queue"
gem "solid_cache"

gem "dry-validation"

group :development, :test do
  # Loads backend/.env (gitignored, see .env.example) into ENV on boot — the
  # local-dev equivalent of the ENV vars Terraform/ECS injects in production
  # (JWT_SECRET, ABA_PAYWAY_MERCHANT_ID/API_KEY, RECAPTCHA_SECRET_KEY, etc.).
  # Never loaded outside development/test, so production always gets its
  # config exclusively from real ENV vars set by ECS.
  gem "dotenv-rails"
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails"
  gem "faker"
end

group :test do
  gem "shoulda-matchers", "~> 8.0"
  gem "database_cleaner-active_record"
end
