# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, except .env.test and .env.example — both are
# committed on purpose. .env.test (see its own header comment) keeps the test
# suite hermetic regardless of what real secrets a developer has filled into
# their own, still-gitignored .env. .env.example is the documentation of what
# every variable does; frontend/.env.example has always been tracked, and this
# one was being silently excluded by the /.env* glob, so nobody cloning the
# repo ever saw it.
/.env*
!/.env.test
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore failure reports.
/spec/examples.txt

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

